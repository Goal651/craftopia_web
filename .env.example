# Database
MONGODB_URI=

# UploadThing (image uploads)
UPLOADTHING_APP_ID=
UPLOADTHING_SECRET=
UPLOADTHING_TOKEN=

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Salt for password hashing (change from the default!)
AUTH_SALT=

# Comma-separated emails that get admin access to /admin and order management
ADMIN_EMAILS=

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=

# Comma-separated admin emails mirrored to the client for UI decisions
NEXT_PUBLIC_ADMIN_EMAILS=
